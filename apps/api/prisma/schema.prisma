}

model AcademicCalendarException {
  id          String   @id @default(uuid())
  tenantId    String
  policyId    String?
  scope       String   @default("TENANT")
  scopeId     String?
  localDate   String
  name        String
  kind        String
  startMinute Int?
  endMinute   Int?
  timezone    String?
  active      Boolean  @default(true)
  actorId     String?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy      Policy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([tenantId, localDate, active])
  @@index([tenantId, scope, scopeId])
  @@index([policyId])
}

model PolicyAssignment {
  id        String    @id @default(uuid())
  tenantId  String
  policyId  String
  scope     String
  scopeId   String?
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  reason    String?
  actorId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy    Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, scopeId])
  @@index([tenantId, active])
  @@index([policyId])
}

model PolicyVersion {
  id        String   @id @default(uuid())
  policyId  String
  version   Int
  snapshot  Json
  summary   String
  actorId   String?
  createdAt DateTime @default(now())
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
}

model LearningMode {
  id        String           @id @default(uuid())
  tenantId  String
  name      String
  modeType  LearningModeType
  priority  Int
  rules     Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId, modeType])
}

model RemoteCommand {
  id                 String        @id @default(uuid())
  tenantId           String
  deviceId           String
  type               String
  status             CommandStatus @default(SUBMITTED)
  reason             String?
  requestedBy        String?
  payload            Json?
  result             Json?
  connectorCommandId String?
  attempts           Int           @default(0)
  maxAttempts        Int           @default(3)
  failureReason      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  expiresAt          DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  lastAttemptAt      DateTime?
  device             Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, deviceId, status])
  @@index([tenantId, type, createdAt])
  @@index([deviceId, createdAt])
}

model AuditEvent {
  id           String        @id @default(uuid())
  tenantId     String?
  actorId      String?
  action       String
  object       String
  objectId     String?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  reason       String?
  outcome      String
  createdAt    DateTime      @default(now())
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  webhookEvent WebhookEvent?

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}
