generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PILOT
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum StudentStatus {
  ACTIVE
  PENDING
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum DeviceStatus {
  PENDING
  ONLINE
  OFFLINE
  NON_COMPLIANT
  LOCKED
  LOST
  RETIRED
  ENROLLMENT_FAILED
}

enum LearningModeType {
  LOST_DEVICE
  EXAM
  EMERGENCY_SUPPORT_OVERRIDE
  TIMETABLE_CLASS
  HOMEWORK_AFTER_SCHOOL
  DEVICE_BASELINE
  DEFAULT_SCHOOL
}

enum CommandStatus {
  SUBMITTED
  QUEUED
  DELIVERED
  EXECUTED
  FAILED
  EXPIRED
}

enum EnrollmentBatchStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Tenant {
  id                              String                           @id @default(uuid())
  name                            String
  domain                          String?                          @unique
  country                         String
  timezone                        String
  language                        String                           @default("en")
  planKey                         String
  status                          TenantStatus                     @default(PILOT)
  logoUrl                         String?
  primaryColor                    String?
  accentColor                     String?
  websiteUrl                      String?
  supportEmail                    String?
  supportPhone                    String?
  studentLabel                    String?
  deviceLabel                     String?
  webFilterSettings               Json?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  branches                        Branch[]
  users                           User[]
  students                        Student[]
  guardians                       Guardian[]
  classes                         ClassSection[]
  rosterImports                   RosterImport[]
  devices                         Device[]
  enrollmentBatches               EnrollmentBatch[]
  appCatalogItems                 AppCatalogItem[]
  policies                        Policy[]
  policyAssignments               PolicyAssignment[]
  timetableBlocks                 TimetableBlock[]
  calendarExceptions              AcademicCalendarException[]
  supportNotes                    SupportNote[]
  supportTickets                  SupportTicket[]
  supportTicketNotes              SupportTicketNote[]
  remoteAssistanceSessions        RemoteAssistanceSession[]
  retentionSettings               RetentionSettings?
  retentionRuns                   DataRetentionRun[]
  billingSubscription             BillingSubscription?
  auditEvents                     AuditEvent[]
  blockedDomainEvents             BlockedDomainEvent[]
  assignmentHistory               DeviceAssignment[]
  lifecycleEvents                 DeviceLifecycleEvent[]
  notificationPreference          NotificationPreference?
  notificationDeliveries          NotificationDelivery[]
  privacyNotices                  PrivacyNotice[]
  privacyAcceptances              PrivacyAcceptance[]
  onboardingProgress              OnboardingProgress?
  teacherClassAssignments         TeacherClassAssignment[]
  teacherSessions                 TeacherSession[]
  teacherSessionEvents            TeacherSessionEvent[]
  teacherSessionTemplates         TeacherSessionTemplate[]
  guardianAfterSchoolControls     GuardianAfterSchoolControl[]
  guardianNotificationPreferences GuardianNotificationPreference[]
  guardianSupportRequests         GuardianSupportRequest[]
  classroomConnection             ClassroomConnection?
  classroomCourseMappings         ClassroomCourseMapping[]
  classroomIdentityMappings       ClassroomIdentityMapping[]
  classroomSyncRuns               ClassroomSyncRun[]
  lmsConnections                  LmsConnection[]
  lmsCourseMappings               LmsCourseMapping[]
  educationConnections            EducationConnection[]
  educationResources              EducationResource[]
  sisMappings                     SisMapping[]
  sisSyncRuns                     SisSyncRun[]
  webhookEndpoints                WebhookEndpoint[]
  webhookEvents                   WebhookEvent[]
  byodStudySessions               ByodStudySession[]
  byodParticipants                ByodSessionParticipant[]
  contentLibraryItems             ContentLibraryItem[]
  attendanceSettings              AttendanceSettings?
  attendanceRecords               AttendanceRecord[]
  automationRules                 AutomationRule[]
  automationExecutions            AutomationExecution[]
  announcements                   Announcement[]
  pilotFeedback                   PilotFeedback[]
  googleWorkspaceConnection       GoogleWorkspaceConnection?
  googleWorkspaceOuMappings       GoogleWorkspaceOuMapping[]
  chromeOsDeviceStates            ChromeOsDeviceState[]
  appleMdmConnection              AppleMdmConnection?
  appleDeviceStates               AppleDeviceState[]
  intuneConnection                IntuneConnection?
  intuneGroupMappings             IntuneGroupMapping[]
  intuneDeviceStates              IntuneDeviceState[]
  enterpriseIdentityConnection    EnterpriseIdentityConnection?
  scimGroupMappings               ScimGroupRoleMapping[]
}

model EnterpriseIdentityConnection {
  id                    String                 @id @default(uuid())
  tenantId              String                 @unique
  protocol              String
  issuer                String
  clientId              String?
  metadataUrl           String?
  credentialReference   String
  scimTokenReference    String
  status                String                 @default("ACTIVE")
  breakGlassUserId      String
  lastValidatedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  breakGlassUser        User                   @relation("BreakGlassUser", fields: [breakGlassUserId], references: [id], onDelete: Restrict)
  groupMappings         ScimGroupRoleMapping[]
  provisionedUsers      User[]                 @relation("ScimProvisionedUsers")
}

model ScimGroupRoleMapping {
  id           String                       @id @default(uuid())
  tenantId     String
  connectionId String
  externalGroup String
  role         String
  branchId     String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection   EnterpriseIdentityConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  branch       Branch?                      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalGroup])
  @@index([tenantId, role])
}

model IntuneConnection {
  id                  String               @id @default(uuid())
  tenantId            String               @unique
  entraTenantId       String
  clientId            String
  credentialReference String
  status              String               @default("AUTHORIZED")
  lastValidatedAt     DateTime?
  lastInventorySyncAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupMappings       IntuneGroupMapping[]
  deviceStates        IntuneDeviceState[]
}

model IntuneGroupMapping {
  id           String           @id @default(uuid())
  tenantId     String
  connectionId String
  groupId      String
  groupName    String
  branchId     String?
  enabled      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection   IntuneConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, groupId])
  @@index([tenantId, enabled])
}

model IntuneDeviceState {
  id                     String           @id @default(uuid())
  tenantId               String
  connectionId           String
  deviceId               String           @unique
  externalDeviceId       String
  groupId                String
  kioskStatus            String           @default("UNKNOWN")
  assessmentStatus       String           @default("UNKNOWN")
  autopilotStatus        String           @default("UNKNOWN")
  appDeploymentStatus    String           @default("UNKNOWN")
  managementHealthStatus String           @default("UNKNOWN")
  lastSyncedAt           DateTime         @default(now())
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection             IntuneConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  device                 Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalDeviceId])
  @@index([tenantId, groupId])
}

model AppleMdmConnection {
  id                    String             @id @default(uuid())
  tenantId              String             @unique
  providerName          String
  serverUrl             String
  credentialReference   String
  appleSchoolManagerId  String
  status                String             @default("AUTHORIZED")
  tokenExpiresAt        DateTime
  certificateExpiresAt  DateTime
  lastValidatedAt       DateTime?
  lastInventorySyncAt   DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceStates          AppleDeviceState[]
}

model AppleDeviceState {
  id                         String             @id @default(uuid())
  tenantId                   String
  connectionId               String
  deviceId                   String             @unique
  externalDeviceId           String
  adeStatus                  String             @default("UNKNOWN")
  supervisionStatus          String             @default("UNKNOWN")
  restrictionStatus          String             @default("UNKNOWN")
  appBookStatus              String             @default("UNKNOWN")
  managedConfigurationStatus String             @default("UNKNOWN")
  lastSyncedAt               DateTime           @default(now())
  tenant                     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection                 AppleMdmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  device                     Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalDeviceId])
  @@index([tenantId, supervisionStatus])
}

model GoogleWorkspaceConnection {
  id                   String                     @id @default(uuid())
  tenantId             String                     @unique
  customerId           String
  delegatedAdminEmail  String
  credentialReference  String
  status               String                     @default("AUTHORIZED")
  lastValidatedAt      DateTime?
  lastInventorySyncAt  DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationalUnits  GoogleWorkspaceOuMapping[]
  chromeOsDeviceStates ChromeOsDeviceState[]
}

model GoogleWorkspaceOuMapping {
  id                     String                    @id @default(uuid())
  tenantId               String
  connectionId           String
  organizationalUnitId   String
  organizationalUnitPath String
  branchId               String?
  enabled                Boolean                   @default(true)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection             GoogleWorkspaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  branch                 Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, organizationalUnitId])
  @@index([tenantId, enabled])
}

model ChromeOsDeviceState {
  id                   String                    @id @default(uuid())
  tenantId             String
  connectionId         String
  deviceId             String                    @unique
  externalDeviceId     String
  organizationalUnitId String
  kioskStatus          String                    @default("UNKNOWN")
  managedSessionStatus String                    @default("UNKNOWN")
  appExtensionStatus   String                    @default("UNKNOWN")
  webPolicyStatus      String                    @default("UNKNOWN")
  lastSyncedAt         DateTime                  @default(now())
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection           GoogleWorkspaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  device               Device                    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalDeviceId])
  @@index([tenantId, organizationalUnitId])
}

model Announcement {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  message     String
  targetRoles String[]
  startsAt    DateTime
  endsAt      DateTime?
  archivedAt  DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt, archivedAt])
}

model PilotFeedback {
  id        String   @id @default(uuid())
  tenantId  String
  role      String
  module    String
  severity  String
  status    String   @default("NEW")
  summary   String
  context   Json?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, severity])
  @@index([tenantId, module, createdAt])
}

model AutomationRule {
  id           String                @id @default(uuid())
  tenantId     String
  name         String
  trigger      String
  conditions   Json
  action       String
  actionConfig Json
  enabled      Boolean               @default(false)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([tenantId, enabled, trigger])
}

model AutomationExecution {
  id          String         @id @default(uuid())
  tenantId    String
  ruleId      String
  fingerprint String
  targetType  String
  targetId    String
  outcome     String
  evidence    Json
  result      Json?
  createdAt   DateTime       @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, fingerprint])
  @@index([tenantId, createdAt])
}

model AttendanceSettings {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  sessionSignalEnabled Boolean  @default(true)
  deviceSignalEnabled  Boolean  @default(true)
  lmsSignalEnabled     Boolean  @default(false)
  teacherSignalEnabled Boolean  @default(true)
  presentThreshold     Int      @default(1)
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id               String    @id @default(uuid())
  tenantId         String
  classId          String
  studentId        String
  attendanceDate   String
  status           String
  derivedStatus    String
  signals          Json
  correctedBy      String?
  correctionReason String?
  correctedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classId, studentId, attendanceDate])
  @@index([tenantId, attendanceDate])
  @@index([tenantId, classId, attendanceDate])
}

model ContentLibraryItem {
  id               String    @id @default(uuid())
  tenantId         String
  title            String
  description      String?
  type             String
  category         String
  locator          String
  grades           String[]
  subjects         String[]
  classIds         String[]
  status           String    @default("ACTIVE")
  expiresAt        DateTime?
  offlineEnabled   Boolean   @default(false)
  offlineVersion   Int?
  offlineSha256    String?
  offlineSizeBytes Int?
  offlinePolicyIds String[]  @default([])
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, expiresAt])
  @@index([tenantId, category, type])
  @@index([tenantId, offlineEnabled, status])
}

model WebhookEndpoint {
  id              String            @id @default(uuid())
  tenantId        String
  name            String
  url             String
  enabled         Boolean           @default(true)
  eventTypes      String[]
  secretReference String
  secretVersion   Int               @default(1)
  maxAttempts     Int               @default(3)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
}

model WebhookEvent {
  id            String            @id @default(uuid())
  tenantId      String
  sourceAuditId String?           @unique
  type          String
  objectType    String
  objectId      String?
  payload       Json
  occurredAt    DateTime
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceAudit   AuditEvent?       @relation(fields: [sourceAuditId], references: [id], onDelete: SetNull)
  deliveries    WebhookDelivery[]

  @@index([tenantId, occurredAt])
  @@index([tenantId, type, occurredAt])
}

model WebhookDelivery {
  id                 String          @id @default(uuid())
  tenantId           String
  endpointId         String
  eventId            String
  status             String          @default("PENDING")
  attemptCount       Int             @default(0)
  nextAttemptAt      DateTime        @default(now())
  lastAttemptAt      DateTime?
  deliveredAt        DateTime?
  responseStatus     Int?
  failureReason      String?
  signatureTimestamp String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  endpoint           WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event              WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([tenantId, status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

model SisMapping {
  id         String   @id @default(uuid())
  tenantId   String
  objectType String
  localId    String
  externalId String
  source     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, objectType, localId, source])
  @@unique([tenantId, objectType, externalId, source])
  @@index([tenantId, objectType, source])
}

model SisSyncRun {
  id              String    @id @default(uuid())
  tenantId        String
  source          String
  status          String
  attempt         Int       @default(1)
  retryOfId       String?
  requestedBy     String?
  totalRecords    Int
  affectedRecords Int       @default(0)
  failedRecords   Int       @default(0)
  records         Json
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, source, status])
}

model EducationConnection {
  id                  String              @id @default(uuid())
  tenantId            String
  provider            String
  credentialReference String
  status              String              @default("ENABLED")
  configuredBy        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resources           EducationResource[]

  @@unique([tenantId, provider])
  @@index([tenantId, status])
}

model EducationResource {
  id           String              @id @default(uuid())
  tenantId     String
  connectionId String
  classId      String
  provider     String
  externalId   String
  displayName  String
  launchUrl    String
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection   EducationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([tenantId, classId, enabled])
}

model LmsConnection {
  id                  String             @id @default(uuid())
  tenantId            String
  provider            String
  baseUrl             String
  credentialReference String
  status              String             @default("ENABLED")
  lastTestedAt        DateTime?
  lastTestOutcome     String?
  configuredBy        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseMappings      LmsCourseMapping[]

  @@unique([tenantId, provider])
  @@index([tenantId, status])
}

model LmsCourseMapping {
  id               String        @id @default(uuid())
  tenantId         String
  connectionId     String
  classId          String
  externalCourseId String
  displayName      String
  launchUrl        String
  enabled          Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection       LmsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, classId])
  @@unique([connectionId, externalCourseId])
  @@index([tenantId, classId, enabled])
}

model ClassroomConnection {
  id                  String                     @id @default(uuid())
  tenantId            String                     @unique
  credentialReference String
  delegatedAdminEmail String
  status              String                     @default("AUTHORIZED")
  lastValidatedAt     DateTime?
  authorizedBy        String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseMappings      ClassroomCourseMapping[]
  identityMappings    ClassroomIdentityMapping[]
  syncRuns            ClassroomSyncRun[]
}

model ClassroomCourseMapping {
  id                 String              @id @default(uuid())
  tenantId           String
  connectionId       String
  classId            String
  externalCourseId   String
  externalCourseName String?
  syncRoster         Boolean             @default(true)
  syncMaterials      Boolean             @default(false)
  enabled            Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection         ClassroomConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classId])
  @@unique([tenantId, externalCourseId])
  @@index([connectionId, enabled])
}

model ClassroomIdentityMapping {
  id             String              @id @default(uuid())
  tenantId       String
  connectionId   String
  localType      String
  localId        String
  externalUserId String
  externalEmail  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection     ClassroomConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, localType, localId])
  @@unique([tenantId, externalUserId])
  @@index([connectionId, localType])
}

model ClassroomSyncRun {
  id                 String              @id @default(uuid())
  tenantId           String
  connectionId       String
  requestedCourseIds String[]            @default([])
  syncRoster         Boolean
  syncMaterials      Boolean
  status             String              @default("QUEUED")
  attempt            Int                 @default(1)
  retryOfId          String?
  outcome            Json?
  errorCode          String?
  errorMessage       String?
  requestedBy        String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection         ClassroomConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([connectionId, status])
}

model OnboardingProgress {
  id          String    @id @default(uuid())
  tenantId    String    @unique
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PrivacyNotice {
  id          String              @id @default(uuid())
  tenantId    String
  noticeType  String
  channel     String
  version     Int
  title       String
  content     String
  publishedBy String?
  publishedAt DateTime            @default(now())
  createdAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acceptances PrivacyAcceptance[]

  @@unique([tenantId, noticeType, channel, version])
  @@index([tenantId, noticeType, channel, publishedAt])
}

model PrivacyAcceptance {
  id           String        @id @default(uuid())
  tenantId     String
  noticeId     String
  subjectType  String
  subjectId    String
  channel      String
  acceptedAt   DateTime      @default(now())
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notice       PrivacyNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, subjectType, subjectId, channel])
  @@index([tenantId, subjectType, subjectId, acceptedAt])
}

model BillingSubscription {
  id                 String                    @id @default(uuid())
  tenantId           String                    @unique
  planKey            String
  status             BillingSubscriptionStatus @default(TRIALING)
  billingEmail       String?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  deviceLimit        Int?
  studentLimit       Int?
  staffLimit         Int?
  branchLimit        Int?
  notes              String?
  updatedBy          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([planKey])
  @@index([status])
}

