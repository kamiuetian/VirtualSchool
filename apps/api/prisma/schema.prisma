generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PILOT
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum StudentStatus {
  ACTIVE
  PENDING
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum DeviceStatus {
  PENDING
  ONLINE
  OFFLINE
  NON_COMPLIANT
  LOCKED
  LOST
  RETIRED
  ENROLLMENT_FAILED
}

enum LearningModeType {
  LOST_DEVICE
  EXAM
  EMERGENCY_SUPPORT_OVERRIDE
  TIMETABLE_CLASS
  HOMEWORK_AFTER_SCHOOL
  DEVICE_BASELINE
  DEFAULT_SCHOOL
}

enum CommandStatus {
  SUBMITTED
  QUEUED
  DELIVERED
  EXECUTED
  FAILED
  EXPIRED
}

enum EnrollmentBatchStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  domain              String?              @unique
  country             String
  timezone            String
  language            String               @default("en")
  planKey             String
  status              TenantStatus         @default(PILOT)
  logoUrl             String?
  primaryColor        String?
  accentColor         String?
  websiteUrl          String?
  supportEmail        String?
  supportPhone        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  branches            Branch[]
  users               User[]
  students            Student[]
  guardians           Guardian[]
  classes             ClassSection[]
  rosterImports       RosterImport[]
  devices             Device[]
  enrollmentBatches   EnrollmentBatch[]
  appCatalogItems     AppCatalogItem[]
  policies            Policy[]
  policyAssignments   PolicyAssignment[]
  timetableBlocks     TimetableBlock[]
  calendarExceptions AcademicCalendarException[]
  supportNotes        SupportNote[]
  retentionSettings   RetentionSettings?
  retentionRuns       DataRetentionRun[]
  billingSubscription BillingSubscription?
  auditEvents         AuditEvent[]
  blockedDomainEvents BlockedDomainEvent[]
  assignmentHistory   DeviceAssignment[]
  lifecycleEvents     DeviceLifecycleEvent[]
}

model BillingSubscription {
  id                 String                    @id @default(uuid())
  tenantId           String                    @unique
  planKey            String
  status             BillingSubscriptionStatus @default(TRIALING)
  billingEmail       String?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  deviceLimit        Int?
  studentLimit       Int?
  staffLimit         Int?
  branchLimit        Int?
  notes              String?
  updatedBy          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([planKey])
  @@index([status])
}

model Branch {
  id              String           @id @default(uuid())
  tenantId        String
  name            String
  timezone        String?
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  students        Student[]
  classes         ClassSection[]
  devices         Device[]
  timetableBlocks TimetableBlock[]

  @@index([tenantId])
}

model User {
  id                String     @id @default(uuid())
  tenantId          String
  branchId          String?
  auth0Subject      String?    @unique
  email             String
  name              String
  role              String
  status            UserStatus @default(INVITED)
  mfaEnabled        Boolean    @default(false)
  invitedBy         String?
  invitedAt         DateTime?
  suspendedAt       DateTime?
  deactivatedAt     DateTime?
  forcedLogoutAt    DateTime?
  lastRoleChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?    @relation(fields: [branchId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Student {
  id          String            @id @default(uuid())
  tenantId    String
  branchId    String?
  studentCode String
  name        String
  grade       String
  section     String?
  status      StudentStatus     @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id])
  guardians   StudentGuardian[]
  devices     Device[]
  classes     ClassMembership[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, grade, section])
}

model Guardian {
  id        String            @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@index([tenantId, email])
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model ClassSection {
  id              String            @id @default(uuid())
  tenantId        String
  branchId        String?
  name            String
  grade           String
  subject         String?
  academicYear    String?
  status          String            @default("ACTIVE")
  archivedAt      DateTime?
  sourceClassId   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?           @relation(fields: [branchId], references: [id])
  members         ClassMembership[]
  devices         Device[]
  timetableBlocks TimetableBlock[]
  sourceClass     ClassSection?      @relation("ClassRollover", fields: [sourceClassId], references: [id])
  rolloverCopies  ClassSection[]     @relation("ClassRollover")

  @@index([tenantId, grade])
  @@index([tenantId, academicYear, status])
  @@index([sourceClassId])
}

model ClassMembership {
  classId   String
  studentId String
  class     ClassSection @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
}

model RosterImport {
  id             String    @id @default(uuid())
  tenantId       String
  filename       String?
  status         String    @default("PREVIEWED")
  totalRows      Int
  validRows      Int
  errorRows      Int
  rows           Json
  errorReportCsv String?
  committedAt    DateTime?
  committedBy    String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model Device {
  id                  String             @id @default(uuid())
  tenantId            String
  branchId            String?
  studentId           String?
  classId             String?
  serialNumber        String
  manufacturer        String?
  model               String?
  androidVersion      String?
  enrollmentId        String?
  mdmConnector        String             @default("ANDROID_MANAGEMENT_API")
  connectorDeviceName String?
  status              DeviceStatus       @default(PENDING)
  lastCheckInAt       DateTime?
  policyVersion       Int?
  enrollmentBatchId   String?
  ownershipType       String             @default("SCHOOL_OWNED")
  health              String             @default("UNKNOWN")
  compliance          String             @default("UNKNOWN")
  tags                String[]           @default([])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch?            @relation(fields: [branchId], references: [id])
  student             Student?           @relation(fields: [studentId], references: [id])
  class               ClassSection?      @relation(fields: [classId], references: [id])
  enrollmentBatch     EnrollmentBatch?   @relation(fields: [enrollmentBatchId], references: [id])
  commands            RemoteCommand[]
  diagnostics         DeviceDiagnostic[]
  alerts              DeviceAlert[]
  blockedDomainEvents BlockedDomainEvent[]
  supportNotes        SupportNote[]
  assignmentHistory   DeviceAssignment[]
  lifecycleEvents     DeviceLifecycleEvent[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId, status])
  @@index([tenantId, enrollmentBatchId])
  @@index([tenantId, mdmConnector])
}

model DeviceAssignment {
  id        String    @id @default(uuid())
  tenantId  String
  deviceId  String
  studentId String?
  classId   String?
  branchId  String?
  reason    String
  actorId   String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, startedAt])
  @@index([tenantId, studentId, startedAt])
  @@index([deviceId, endedAt])
}

model DeviceLifecycleEvent {
  id        String   @id @default(uuid())
  tenantId  String
  deviceId  String
  type      String
  reason    String
  actorId   String?
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, createdAt])
}

model SupportNote {
  id          String   @id @default(uuid())
  tenantId    String
  deviceId    String
  authorId    String?
  authorEmail String?
  category    String   @default("GENERAL")
  severity    String   @default("S3")
  status      String   @default("OPEN")
  visibility  String   @default("INTERNAL")
  pinned      Boolean  @default(false)
  body        String
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, createdAt])
  @@index([tenantId, status, severity])
}

model RetentionSettings {
  id                          String   @id @default(uuid())
  tenantId                    String   @unique
  diagnosticRetentionDays     Int      @default(90)
  resolvedAlertRetentionDays  Int      @default(180)
  commandHistoryRetentionDays Int      @default(365)
  supportNoteRetentionDays    Int      @default(730)
  exportArtifactRetentionDays Int      @default(30)
  auditRetentionDays          Int?
  updatedBy                   String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  tenant                      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DataRetentionRun {
  id          String    @id @default(uuid())
  tenantId    String
  mode        String
  status      String    @default("COMPLETED")
  actorId     String?
  result      Json
  cutoffs     Json
  reason      String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, mode, status])
}

model DeviceDiagnostic {
  id              String   @id @default(uuid())
  tenantId        String
  deviceId        String
  batteryLevel    Int?
  storageFreeMb   Int?
  networkStatus   String?
  launcherVersion String?
  browserVersion  String?
  mdmPolicyName   String?
  policyVersion   Int?
  health          String?
  compliance      String?
  details         Json?
  reportedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, reportedAt])
  @@index([tenantId, reportedAt])
}

model DeviceAlert {
  id             String    @id @default(uuid())
  tenantId       String
  deviceId       String?
  type           String
  severity       String
  status         String    @default("OPEN")
  title          String
  message        String
  source         String
  metadata       Json?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  device         Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, severity])
  @@index([tenantId, deviceId, status])
  @@index([tenantId, type, status])
}

model EnrollmentBatch {
  id            String                @id @default(uuid())
  tenantId      String
  name          String
  token         String                @unique
  status        EnrollmentBatchStatus @default(ACTIVE)
  expiresAt     DateTime?
  maxDevices    Int?
  qrPayload     Json
  enrolledCount Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices       Device[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model AppCatalogItem {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  packageId      String
  category       String?
  iconUrl        String?
  description    String?
  approvedGrades String[]
  installRules   Json?
  approvalStatus String   @default("APPROVED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, packageId])
  @@index([tenantId, approvalStatus])
}

model Policy {
  id                 String             @id @default(uuid())
  tenantId           String
  name               String
  status             String             @default("DRAFT")
  version            Int                @default(1)
  rules              Json
  mdmPolicyName      String?
  mdmPublishStatus   String?
  mdmPublishedAt     DateTime?
  mdmPublishError    String?
  mdmPublishRequest  Json?
  mdmPublishResponse Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions           PolicyVersion[]
  assignments        PolicyAssignment[]
  timetableBlocks    TimetableBlock[]
  calendarExceptions AcademicCalendarException[]
  blockedDomainEvents BlockedDomainEvent[]

  @@index([tenantId, status])
  @@index([tenantId, mdmPublishStatus])
}

model BlockedDomainEvent {
  id            String   @id @default(uuid())
  tenantId      String
  deviceId      String?
  policyId      String
  policyVersion Int
  domain        String
  reason        String
  matchedRule   String?
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, domain, occurredAt])
  @@index([policyId, policyVersion])
}

model TimetableBlock {
  id             String        @id @default(uuid())
  tenantId       String
  branchId       String?
  policyId       String
  scope          String
  scopeId        String?
  classId        String?
  grade          String?
  name           String
  subject        String?
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  timezone       String?
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  active         Boolean       @default(true)
  actorId        String?
  reason         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id])
  policy         Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  class          ClassSection? @relation(fields: [classId], references: [id])

  @@index([tenantId, active, dayOfWeek])
  @@index([tenantId, scope, scopeId])
  @@index([tenantId, classId])
  @@index([policyId])
}

model AcademicCalendarException {
  id          String   @id @default(uuid())
  tenantId    String
  policyId    String?
  scope       String   @default("TENANT")
  scopeId     String?
  localDate   String
  name        String
  kind        String
  startMinute Int?
  endMinute   Int?
  timezone    String?
  active      Boolean  @default(true)
  actorId     String?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy      Policy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([tenantId, localDate, active])
  @@index([tenantId, scope, scopeId])
  @@index([policyId])
}

model PolicyAssignment {
  id        String    @id @default(uuid())
  tenantId  String
  policyId  String
  scope     String
  scopeId   String?
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  reason    String?
  actorId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy    Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, scopeId])
  @@index([tenantId, active])
  @@index([policyId])
}

model PolicyVersion {
  id        String   @id @default(uuid())
  policyId  String
  version   Int
  snapshot  Json
  summary   String
  actorId   String?
  createdAt DateTime @default(now())
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
}

model LearningMode {
  id        String           @id @default(uuid())
  tenantId  String
  name      String
  modeType  LearningModeType
  priority  Int
  rules     Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId, modeType])
}

model RemoteCommand {
  id                 String        @id @default(uuid())
  tenantId           String
  deviceId           String
  type               String
  status             CommandStatus @default(SUBMITTED)
  reason             String?
  requestedBy        String?
  payload            Json?
  result             Json?
  connectorCommandId String?
  attempts           Int           @default(0)
  maxAttempts        Int           @default(3)
  failureReason      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  expiresAt          DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  lastAttemptAt      DateTime?
  device             Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, deviceId, status])
  @@index([tenantId, type, createdAt])
  @@index([deviceId, createdAt])
}

model AuditEvent {
  id        String   @id @default(uuid())
  tenantId  String?
  actorId   String?
  action    String
  object    String
  objectId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  reason    String?
  outcome   String
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}
