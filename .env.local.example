# Local development only. Never use this profile in a deployed environment.
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
API_CORS_ORIGINS=http://127.0.0.1:3000
API_DOCS_ENABLED=true
API_TRUST_PROXY=false
DATABASE_URL=postgresql://virtualschool_local:CHANGE_ME@127.0.0.1:5432/virtualschool_local?schema=public
REDIS_URL=redis://127.0.0.1:6379
AUTH_MODE=development
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
ADMIN_API_BASE_URL=http://127.0.0.1:4000/api/v1
ADMIN_AUTH_BYPASS=false
ADMIN_LOCAL_TEST_AUTH=true
ADMIN_LOCAL_TEST_PASSWORD=replace-with-a-local-only-password
APP_BASE_URL=http://127.0.0.1:3000
# Real MDM is required even locally for command/policy dispatch. Use test doubles only in tests.
MDM_CONNECTOR_MODE=android-management
ANDROID_MANAGEMENT_API_BASE_URL=https://androidmanagement.googleapis.com
ANDROID_MANAGEMENT_ENTERPRISE_ID=
GOOGLE_APPLICATION_CREDENTIALS=
