# Shared
NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
API_REQUEST_BODY_LIMIT=1mb
API_TRUST_PROXY=true
DATABASE_URL=postgresql://virtualschool:virtualschool@localhost:5432/virtualschool?schema=public
REDIS_URL=redis://localhost:6379
CLASSROOM_SYNC_PROVIDER_URL=
CLASSROOM_SYNC_PROVIDER_TOKEN=
WORKER_CLASSROOM_SYNC_INTERVAL_MS=60000
AUTH_MODE=development
ALLOW_DEVELOPMENT_AUTH_IN_PRODUCTION=false
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.virtualschool.local
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_JWKS_URI=

# Admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
ADMIN_API_BASE_URL=http://localhost:4000/api/v1
ADMIN_AUTH_BYPASS=false
ADMIN_API_EMAIL=admin@example.edu
ADMIN_API_NAME=School administrator
ADMIN_API_ROLE=PLATFORM_SUPER_ADMIN
ADMIN_API_TENANT_ID=*
APP_BASE_URL=http://localhost:3000
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Android Management API
MDM_CONNECTOR_MODE=stub
ANDROID_MANAGEMENT_API_BASE_URL=https://androidmanagement.googleapis.com
ANDROID_MANAGEMENT_ENTERPRISE_ID=
ANDROID_ENTERPRISE_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Alert email delivery
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_TOKEN=
EMAIL_FROM=alerts@example.edu
EMAIL_DELIVERY_TIMEOUT_MS=10000
WORKER_NOTIFICATION_INTERVAL_MS=60000
WORKER_ENGAGEMENT_SCAN_INTERVAL_MS=3600000
WORKER_AUTOMATION_INTERVAL_MS=60000
WORKER_NOTIFICATION_BATCH_SIZE=100

# Signed education-operation webhooks. Values are secret-manager references
# mapped to runtime secret values; never commit production secret material.
WEBHOOK_SIGNING_SECRETS_JSON={}
WORKER_WEBHOOK_INTERVAL_MS=30000
WORKER_WEBHOOK_BATCH_SIZE=100
WORKER_WEBHOOK_CAPTURE_BATCH_SIZE=250
WEBHOOK_DELIVERY_TIMEOUT_MS=10000

# AWS placeholders
AWS_REGION=us-east-1
S3_IMPORT_BUCKET=
SENTRY_DSN=
