# Production configuration contract. Do not copy local credentials into this file.
NODE_ENV=production
LOG_LEVEL=info

# API
API_PORT=4000
API_CORS_ORIGINS=https://admin.example.invalid
API_DOCS_ENABLED=false
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
API_REQUEST_BODY_LIMIT=1mb
API_TRUST_PROXY=false
DATABASE_URL=
REDIS_URL=rediss://
CLASSROOM_SYNC_PROVIDER_URL=
CLASSROOM_SYNC_PROVIDER_TOKEN=
WORKER_CLASSROOM_SYNC_INTERVAL_MS=60000
AUTH_MODE=auth0
ALLOW_DEVELOPMENT_AUTH_IN_PRODUCTION=false
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER_BASE_URL=
AUTH0_JWKS_URI=

# Admin
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid/api/v1
ADMIN_API_BASE_URL=https://api.example.invalid/api/v1
ADMIN_AUTH_BYPASS=false
ADMIN_LOCAL_TEST_AUTH=false
APP_BASE_URL=https://admin.example.invalid
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Android Management API
MDM_CONNECTOR_MODE=android-management
ANDROID_MANAGEMENT_API_BASE_URL=https://androidmanagement.googleapis.com
ANDROID_MANAGEMENT_ENTERPRISE_ID=
ANDROID_ENTERPRISE_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Alert email delivery
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_TOKEN=
EMAIL_FROM=alerts@example.edu
EMAIL_DELIVERY_TIMEOUT_MS=10000
WORKER_NOTIFICATION_INTERVAL_MS=60000
WORKER_ENGAGEMENT_SCAN_INTERVAL_MS=3600000
WORKER_AUTOMATION_INTERVAL_MS=60000
WORKER_NOTIFICATION_BATCH_SIZE=100

# Signed education-operation webhooks. Values are secret-manager references
# mapped to runtime secret values; never commit production secret material.
WEBHOOK_SIGNING_SECRETS_JSON={}
WORKER_WEBHOOK_INTERVAL_MS=30000
WORKER_WEBHOOK_BATCH_SIZE=100
WORKER_WEBHOOK_CAPTURE_BATCH_SIZE=250
WEBHOOK_DELIVERY_TIMEOUT_MS=10000

# External services (inject secrets through the deployment secret manager)
AWS_REGION=
S3_IMPORT_BUCKET=
SENTRY_DSN=
